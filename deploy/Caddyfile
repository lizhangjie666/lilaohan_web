{$SITE_ADDRESS:http://localhost} {
  encode zstd gzip

  # IP 验收阶段按店主要求开放后台。这里同时代理 Strapi 后台依赖的插件接口，
  # 避免只打开登录页却无法管理内容或上传图片。
  @strapiAdmin path /admin /admin/* /content-manager /content-manager/* /content-type-builder /content-type-builder/* /upload /upload/* /i18n /i18n/* /users-permissions /users-permissions/* /review-workflows /review-workflows/* /releases /releases/* /email /email/* /cloud /cloud/*
  handle @strapiAdmin {
    header {
      Cache-Control "no-store"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "DENY"
      Referrer-Policy "same-origin"
    }
    reverse_proxy backend:1337
  }

  # 顾客投稿接口只接收压缩后的单张图片，代理层先拒绝异常大的请求。
  handle /api/oven/* {
    request_body {
      max_size 6MB
    }
    reverse_proxy backend:1337
  }

  handle /api/* {
    reverse_proxy backend:1337
  }

  handle /uploads/* {
    reverse_proxy backend:1337 {
      header_down Cache-Control "public, max-age=31536000, immutable"
    }
  }

  handle /images/* {
    reverse_proxy frontend:3000 {
      header_down Cache-Control "public, max-age=31536000, immutable"
    }
  }

  handle {
    reverse_proxy frontend:3000
  }
}
