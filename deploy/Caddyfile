{$SITE_ADDRESS:http://localhost} {
  encode zstd gzip

  # 仅通过服务器本机端口和 SSH 隧道访问后台，避免 IP 验收阶段使用明文公网登录。
  handle /admin* {
    respond "Not Found" 404
  }

  handle /api/* {
    reverse_proxy backend:1337
  }

  handle /uploads/* {
    reverse_proxy backend:1337 {
      header_down Cache-Control "public, max-age=31536000, immutable"
    }
  }

  handle /images/* {
    reverse_proxy frontend:3000 {
      header_down Cache-Control "public, max-age=31536000, immutable"
    }
  }

  handle {
    reverse_proxy frontend:3000
  }
}
