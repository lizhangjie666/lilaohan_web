{
  "kind": "collectionType",
  "collectionName": "oven_orders",
  "info": {
    "singularName": "oven-order",
    "pluralName": "oven-orders",
    "displayName": "出炉进度",
    "description": "店员登记的顾客面包制作与取件进度"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "serialNumber": { "type": "integer", "required": true, "unique": true, "min": 1 },
    "customerName": { "type": "string", "required": true, "maxLength": 30 },
    "phoneEncrypted": { "type": "text", "private": true },
    "phoneHash": { "type": "string", "private": true, "required": true },
    "phoneLast4": { "type": "string", "private": true, "required": true, "maxLength": 4 },
    "startedAt": { "type": "datetime", "required": true },
    "estimatedReadyAt": { "type": "datetime", "required": true },
    "status": {
      "type": "enumeration",
      "enum": ["processing", "ready", "collected", "cancelled"],
      "default": "processing",
      "required": true
    },
    "beforeImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "afterImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "collectedAt": { "type": "datetime" },
    "phonePurgedAt": { "type": "datetime", "private": true }
  }
}
